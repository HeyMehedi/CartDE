{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cartde",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cartde-db",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cartde-media",
		},
	],
	// Checkout abuse damping (SRS NFR-1). Per Cloudflare location and approximate by design; see docs/deployment.md.
	"ratelimits": [
		{ "name": "CHECKOUT_IP_LIMITER", "namespace_id": "4801", "simple": { "limit": 60, "period": 60 } },
		{ "name": "CHECKOUT_PHONE_LIMITER", "namespace_id": "4802", "simple": { "limit": 5, "period": 60 } },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
