---
import Base from "../../layouts/Base.astro";
import { mediaUrls, storefrontProduct } from "../../cartde/app/catalogue";
import { storefrontContext } from "../../cartde/app/storefront";
import { clientMessages } from "../../cartde/i18n/messages";
import { ADMIN_ROLE_LEVEL } from "../../cartde/app/guard";
import { formatMoney } from "../../cartde/domain/money";
import { renderMarkdown } from "../../cartde/domain/markdown";

const user = Astro.locals.user;
const isAdmin = !!user && !user.disabled && user.role >= ADMIN_ROLE_LEVEL;
const product = await storefrontProduct(Astro.params.slug!, isAdmin);
if (!product) return Astro.rewrite("/404");

const preview = product.status !== "active";
if (isAdmin) Astro.response.headers.set("Cache-Control", "private, no-store"); // never cache an admin's view
if (preview) Astro.response.headers.set("X-Robots-Tag", "noindex");

const [{ store, t, lang }, urls] = await Promise.all([storefrontContext(), mediaUrls(product.media.map((m) => m.media_id))]);
const money = (n: number) => formatMoney(n, store.currency, store.locale);
const variants = product.variants.filter((v) => v.status === "active" || preview);
const prices = variants.map((v) => v.price_minor);
const from = Math.min(...prices);
const to = Math.max(...prices);
const first = variants.find((v) => v.stock_qty > 0) ?? variants[0]!;
const images = product.media.flatMap((m) =>
	urls.get(m.media_id) ? [{ url: new URL(urls.get(m.media_id)!, Astro.url).toString(), alt: m.alt }] : [],
);
const canonical = new URL(`/products/${product.slug}`, Astro.url).toString();
const plain = product.description_md
	.replace(/[*_`#>[\]()-]/g, "")
	.replace(/\s+/g, " ")
	.trim()
	.slice(0, 300);
const inStock = variants.some((v) => v.stock_qty > 0);
const offer = (price: number) => ({
	"@type": "Offer",
	price: (price / 100).toFixed(2),
	priceCurrency: store.currency,
	availability: `https://schema.org/${inStock ? "InStock" : "OutOfStock"}`,
	url: canonical,
});
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: product.name,
	description: product.seo_description || plain || undefined,
	image: images.map((i) => i.url),
	sku: first.sku ?? undefined,
	offers:
		from === to
			? offer(from)
			: {
					"@type": "AggregateOffer",
					lowPrice: (from / 100).toFixed(2),
					highPrice: (to / 100).toFixed(2),
					priceCurrency: store.currency,
					offerCount: variants.length,
					availability: `https://schema.org/${inStock ? "InStock" : "OutOfStock"}`,
				},
};
const ld = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const i18n = JSON.stringify(
	clientMessages(lang, [
		"product.in_stock",
		"product.out_of_stock",
		"product.only_left",
		"product.added",
		"product.view_cart",
		"product.unavailable_combo",
	]),
).replace(/</g, "\\u003c");
const clientData = JSON.stringify({
	currency: store.currency,
	locale: store.locale,
	lowStock: store.low_stock_threshold,
	options: product.options.map((o) => ({ name: o.name, values: o.values.map((v) => v.value) })),
	variants: variants.map((v) => ({
		id: v.id,
		title: v.title,
		values: v.option_values,
		price: v.price_minor,
		compare: v.compare_at_minor,
		stock: v.stock_qty,
	})),
}).replace(/</g, "\\u003c");
---

<Base
	title={product.seo_title || product.name}
	description={product.seo_description || plain || null}
	canonical={canonical}
	image={images[0]?.url ?? null}
>
	<Fragment slot="head">
		{preview && <meta name="robots" content="noindex" />}
		<script type="application/ld+json" set:html={ld} />
	</Fragment>
	{preview && (
		<p role="status" class="cd-alert">
			{t("product.preview", { status: product.status })}
		</p>
	)}
	<div class="cd-split">
		<div>
			{images.map((i) => (
				<img src={i.url} alt={i.alt} style="margin-bottom:.5rem" />
			))}
		</div>
		<div id="product" data-variant={first.id}>
			<h1>{product.name}</h1>
			<p class="cd-price" id="price">
				{from === to ? money(from) : `${money(from)} – ${money(to)}`}
			</p>
			<script type="application/json" id="product-data" set:html={clientData} />
			<div id="options" hidden></div>
			<p id="stock" role="status" class="cd-muted">
				{!inStock
					? t("product.out_of_stock")
					: first.stock_qty <= store.low_stock_threshold
						? t("product.only_left", { n: first.stock_qty })
						: t("product.in_stock")}
			</p>
			<p id="add-msg" role="status" class="cd-muted"></p>
			<button type="button" class="cd-btn" id="add" disabled={!inStock || preview}>
				{t("product.add")}
			</button>
			<noscript>
				<p class="cd-muted">{t("product.needs_js")}</p>
			</noscript>
			<script type="application/json" id="i18n" set:html={i18n} />
			<div set:html={renderMarkdown(product.description_md)} />
			{variants.length > 1 && (
				<table class="cd-table">
					<caption class="cd-muted">{t("product.all_options")}</caption>
					<thead>
						<tr>
							<th>{t("product.option")}</th>
							<th>{t("product.price")}</th>
							<th>{t("product.availability")}</th>
						</tr>
					</thead>
					<tbody>
						{variants.map((v) => (
							<tr>
								<td>{v.title}</td>
								<td>
									{money(v.price_minor)}
									{v.compare_at_minor && v.compare_at_minor > v.price_minor && <s class="cd-muted"> {money(v.compare_at_minor)}</s>}
								</td>
								<td>
									{v.stock_qty < 1
										? t("product.out_of_stock")
										: v.stock_qty <= store.low_stock_threshold
											? t("product.only_left", { n: v.stock_qty })
											: t("product.in_stock")}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			)}
		</div>
	</div>
</Base>

<script>
	import "../../cartde/client/product-page";
</script>
