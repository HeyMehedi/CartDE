---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 10,
});
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<section>
		<h1>{siteTitle}</h1>
		<p>{siteTagline}</p>
		<p>
			CartDE is open-source commerce software for running your own online store on Cloudflare.
			Catalogue, cart, checkout and order management are planned for the next releases. This page is the foundation.
		</p>
		<p><a href="/_emdash/admin">Open the admin</a></p>
	</section>

	<section>
		<h2>Recent posts</h2>
		{
			posts.length === 0 ? (
				<p>
					No posts yet. <a href="/_emdash/admin/content/posts/new">Create one</a>.
				</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<div {...post.edit.featured_image}><Image image={post.data.featured_image} /></div>
								)}
								<h3 {...post.edit.title}>{post.data.title}</h3>
							</a>
							{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
							{post.data.publishedAt && (
								<time datetime={post.data.publishedAt.toISOString()}>
									{post.data.publishedAt.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							)}
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>
