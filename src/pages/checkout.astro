---
import Base from "../layouts/Base.astro";
import { adminStore } from "../cartde/app/catalogue";
import { DISTRICTS } from "../cartde/domain/geo/districts";
import { formatMoney } from "../cartde/domain/money";
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex");
const store = await adminStore();
const fee = (n: number) => formatMoney(n, store.currency, store.locale);
const ready = store.status !== "paused";
---

<Base title="Checkout">
	<h1>Checkout</h1>
	{!ready && <p class="cd-alert">This store is not taking orders right now. Please come back soon.</p>}
	<div id="empty" hidden>Your cart is empty. <a href="/products">Browse products</a>.</div>
	<div class="cd-split wide-left" id="checkout" hidden={!ready}>
		<form id="checkout-form" novalidate>
			<div id="form-error" class="cd-alert" role="alert" hidden></div>
			<div class="cd-field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" /><div class="cd-error" data-err="name"></div></div>
			<div class="cd-field"><label for="phone">Mobile number</label><input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="01XXXXXXXXX" /><div class="cd-error" data-err="phone"></div></div>
			<div class="cd-field"><label for="email">Email (optional)</label><input id="email" name="email" type="email" autocomplete="email" maxlength="120" /><div class="cd-error" data-err="email"></div></div>
			<div class="cd-field">
				<label for="district">District</label>
				<select id="district" name="district" required>
					<option value="">Choose…</option>
					{DISTRICTS.map((d) => <option value={d}>{d}</option>)}
				</select>
				<div class="cd-error" data-err="district"></div>
			</div>
			<div class="cd-field"><label for="area">Area / thana</label><input id="area" name="area" required maxlength="100" /><div class="cd-error" data-err="area"></div></div>
			<div class="cd-field"><label for="address">Address</label><textarea id="address" name="address" rows="3" required minlength="5" maxlength="200" autocomplete="street-address"></textarea><div class="cd-error" data-err="address"></div></div>
			<div class="cd-field"><label for="note">Order note (optional)</label><textarea id="note" name="note" rows="2" maxlength="500"></textarea></div>
			<p class="cd-muted">Payment: cash on delivery. Delivery charge: {fee(store.delivery_inside_dhaka_minor)} inside Dhaka, {fee(store.delivery_outside_dhaka_minor)} outside Dhaka.</p>
			<button class="cd-btn" id="place" type="submit">Place order</button>
		</form>
		<aside aria-labelledby="sum-h">
			<h2 id="sum-h">Order summary</h2>
			<table class="cd-table"><tbody id="summary"></tbody></table>
			<p>Subtotal: <span id="sub"></span></p>
			<p>Delivery: <span id="del">Choose a district</span></p>
			<p><strong>Total: <span id="tot"></span></strong></p>
		</aside>
	</div>
</Base>

<script>
	import "../cartde/client/checkout-page";
</script>
