---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { adminCustomer, adminStore } from "../../../cartde/app/catalogue";
import { CartdeError } from "../../../cartde/db/util";
import { formatMoney } from "../../../cartde/domain/money";

let data;
try {
	data = await adminCustomer(Astro.params.id!);
} catch (err) {
	if (err instanceof CartdeError && err.code === "not_found") return new Response("Customer not found", { status: 404 });
	throw err;
}
const store = await adminStore();
const { customer, orders } = data;
---

<AdminLayout title={customer.name} active="customers">
	<h1>{customer.name}</h1>
	<p>{customer.phone}{customer.email && ` · ${customer.email}`}</p>
	<table>
		<thead><tr><th>Order</th><th>Status</th><th>Total</th></tr></thead>
		<tbody>{orders.map((o) => <tr><td><a href={`/admin/orders/${o.id}`}>#{o.order_number}</a></td><td>{o.status}</td><td>{formatMoney(o.total_minor, o.currency, store.locale)}</td></tr>)}</tbody>
	</table>
</AdminLayout>
