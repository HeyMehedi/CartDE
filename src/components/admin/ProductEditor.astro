---
import type { CategoryRow } from "../../cartde/db/categories";
import type { ProductDetail } from "../../cartde/db/products";

interface Props {
	categories: CategoryRow[];
	product?: ProductDetail & { media: (ProductDetail["media"][number] & { url: string | null })[] };
	currency?: string;
}
const { categories, product, currency = "BDT" } = Astro.props;
const mode = product ? "edit" : "create";
// JSON in a script tag: escape "<" so a description can never close the tag.
const data = JSON.stringify({ mode, product: product ?? null, currency }).replace(/</g, "\\u003c");
---

<div id="editor" data-mode={mode}>
	<script type="application/json" id="editor-data" set:html={data} />
	<div id="msg" role="alert" hidden class="error"></div>

	<form id="product-form">
		<label for="name">Name</label>
		<input id="name" name="name" type="text" required maxlength="200" value={product?.name ?? ""} />

		<label for="slug">URL slug {mode === "create" && <span class="muted">(leave empty to generate)</span>}</label>
		<input id="slug" name="slug" type="text" maxlength="80" value={product?.slug ?? ""} />

		<label for="description_md">
			Description <span class="muted">(Markdown: **bold**, *italic*, - lists, links)</span>
		</label>
		<textarea id="description_md" name="description_md" rows="7">{product?.description_md ?? ""}</textarea>

		<div class="row">
			<div>
				<label for="status">Status</label>
				<select id="status" name="status">
					{["draft", "active", "archived"].map((s) => (
						<option value={s} selected={(product?.status ?? "draft") === s}>
							{s}
						</option>
					))}
				</select>
			</div>
		</div>

		<fieldset>
			<legend>Categories</legend>
			{categories.length === 0 && (
				<span class="muted">
					None yet. <a href="/admin/categories">Create categories</a>.
				</span>
			)}
			{categories.map((c) => (
				<label style="display:inline-block;margin-right:1rem;font-weight:400">
					<input type="checkbox" name="category" value={c.id} checked={product?.category_ids.includes(c.id)} /> {c.name}
				</label>
			))}
		</fieldset>

		<fieldset>
			<legend>
				Images <span class="muted">(first image is the featured image)</span>
			</legend>
			<ul id="media-list" style="list-style:none;padding:0"></ul>
			<button type="button" id="media-choose">
				Choose from media library
			</button>
			<div id="media-dialog" hidden>
				<p class="muted">
					Upload new files in the{" "}
					<a href="/_emdash/admin" target="_blank" rel="noopener">
						EmDash media library
					</a>
					, then choose them here.
				</p>
				<div id="media-grid" class="row"></div>
			</div>
		</fieldset>

		<fieldset>
			<legend>Search engines</legend>
			<label for="seo_title">SEO title</label>
			<input id="seo_title" type="text" maxlength="70" value={product?.seo_title ?? ""} />
			<label for="seo_description">SEO description</label>
			<input id="seo_description" type="text" maxlength="160" value={product?.seo_description ?? ""} />
		</fieldset>

		{mode === "create" && (
			<fieldset>
				<legend>Options and variants</legend>
				<p class="muted">Up to 3 options (for example Size: S, M, L). Leave empty for a product with one price.</p>
				<div id="options"></div>
				<button type="button" id="option-add">
					Add option
				</button>
				<button type="button" id="variants-build">
					Build variants
				</button>
				<div class="scroll">
					<table id="variants-table">
						<thead>
							<tr>
								<th>Variant</th>
								<th>Price ({currency})</th>
								<th>Compare-at</th>
								<th>SKU</th>
								<th>Stock</th>
								<th>Active</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</fieldset>
		)}

		<button type="submit" id="save">
			{mode === "create" ? "Create product" : "Save changes"}
		</button>
		{mode === "edit" && product?.status === "draft" && (
			<button type="button" id="delete" style="margin-left:1rem">
				Delete draft
			</button>
		)}
	</form>

	{mode === "edit" && product && (
		<section>
			<h2>Variants and stock</h2>
			<p class="muted">
				Options:{" "}
				{product.options.length ? product.options.map((o) => `${o.name} (${o.values.map((v) => v.value).join(", ")})`).join("; ") : "none"}
			</p>
			<div class="scroll">
				<table id="variants-edit">
					<thead>
						<tr>
							<th>Variant</th>
							<th>Price</th>
							<th>Compare-at</th>
							<th>SKU</th>
							<th>Active</th>
							<th>Stock</th>
							<th></th>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
			<h3>Add variant</h3>
			<div class="row" id="variant-add">
				{product.options.map((o) => (
					<div>
						<label>{o.name}</label>
						<input type="text" data-option-value maxlength="80" />
					</div>
				))}
				<div>
					<label>Price</label>
					<input type="text" id="nv-price" inputmode="decimal" />
				</div>
				<div>
					<label>SKU</label>
					<input type="text" id="nv-sku" />
				</div>
				<div>
					<label>Stock</label>
					<input type="text" id="nv-stock" inputmode="numeric" value="0" />
				</div>
				<button type="button" id="nv-add">
					Add variant
				</button>
			</div>
		</section>
	)}
</div>

<script>
	import "../../cartde/client/product-editor";
</script>
