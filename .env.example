# Copy to .env for local development. Never commit .env.
# Production secrets are set with: pnpm wrangler secret put <NAME>

# Encrypts plugin secret settings. Generated by the scaffold for local use.
# Format: emdash_enc_v1_<43 base64url chars>. Generate one with: pnpm exec emdash secrets generate
# Keep a copy separate from database backups; losing it makes encrypted settings unreadable.
EMDASH_ENCRYPTION_KEY=

# Public origin of the site, e.g. https://shop.example.com.
# Needed so passkeys, CSRF checks and canonical URLs match the browser address.
EMDASH_SITE_URL=
